        <button class="theme-toggle" id="themeToggleMobile" style="align-self:flex-start;" aria-label="Toggle theme">☀️</button>
    </div>

    <div class="main-container">

        <section class="hero reveal">
            <div class="hero-accent-line"></div>
            <span class="hero-badge">
                <span class="hero-badge-dot"></span> Central University of Rajasthan
            </span>
            <h1>Rounak Ranjan</h1>
            <p class="subtitle">Biochemistry Student &nbsp;•&nbsp; Aspiring Computational Biologist &nbsp;•&nbsp; Creator Partnerships</p>
