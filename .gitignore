<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rounak Ranjan | Biochemistry • Computational Biology • Creator Partnerships</title>
    <meta name="description" content="Rounak Ranjan — Biochemistry student at CURAJ, aspiring computational biologist, and creator partnership specialist.">
    <meta name="keywords" content="Rounak Ranjan, biochemistry, computational biology, bioinformatics, CURAJ, creator partnerships, brand outreach">
    <meta name="author" content="Rounak Ranjan">
    <meta property="og:title" content="Rounak Ranjan | Biochemistry • Computational Biology">
    <meta property="og:description" content="Building at the intersection of biology, data, and technology.">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            /* DARK THEME (DEFAULT) */
            --bg-deep: #060b14;
            --bg-primary: #0b1121;
            --bg-secondary: #111b2e;
            --bg-surface: #151f36;
            --bg-surface-hover: #1a2740;
            --bg-card: #111b2e;
            --bg-glass: rgba(17, 27, 46, 0.8);

            --text-primary: #f0f4fc;
            --text-secondary: #c8d6e5;
            --text-muted: #7b8ca8;
            --text-accent: #5eeadb;

            --accent: #2dd4bf;
            --accent-bright: #5eeadb;
            --accent-deep: #0d9488;
            --accent-glow: rgba(45, 212, 191, 0.25);
            --accent-glow-strong: rgba(94, 234, 219, 0.4);

            --border: #1e2d47;
            --border-light: #263554;
            --border-accent: rgba(45, 212, 191, 0.3);

            --gradient-hero: linear-gradient(160deg, #060b14 0%, #0b1121 30%, #0f1a2e 60%, #0b1121 100%);
            --gradient-card: linear-gradient(145deg, #111b2e 0%, #151f36 100%);
            --gradient-accent: linear-gradient(135deg, #2dd4bf 0%, #5eeadb 100%);
            --gradient-text: linear-gradient(135deg, #f0f4fc 0%, #a5b4cb 100%);

            --tag-bg: #0d1f2e;
            --tag-text: #5eeadb;
            --tag-border: rgba(45, 212, 191, 0.2);

            --card-shadow: 0 2px 8px rgba(0,0,0,0.4), 0 1px 2px rgba(0,0,0,0.3);
            --card-shadow-hover: 0 12px 40px rgba(0,0,0,0.6), 0 2px 8px rgba(45,212,191,0.08);
            --card-shadow-accent: 0 8px 32px rgba(45,212,191,0.12), 0 2px 8px rgba(0,0,0,0.4);

            --nav-bg: rgba(6, 11, 20, 0.88);
            --nav-blur: blur(20px);
            --radius: 16px;
            --radius-sm: 10px;
            --radius-xs: 6px;
            --transition: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        [data-theme="light"] {
            --bg-deep: #f8fafc;
            --bg-primary: #ffffff;
            --bg-secondary: #f1f5f9;
            --bg-surface: #ffffff;
            --bg-surface-hover: #f8fafc;
            --bg-card: #ffffff;
            --bg-glass: rgba(255,255,255,0.8);

            --text-primary: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
            --text-accent: #0d9488;

            --accent: #0d9488;
            --accent-bright: #14b8a6;
            --accent-deep: #0f766e;
            --accent-glow: rgba(13, 148, 136, 0.15);
            --accent-glow-strong: rgba(20, 184, 166, 0.25);

            --border: #e2e8f0;
            --border-light: #f1f5f9;
            --border-accent: rgba(13, 148, 136, 0.2);

            --gradient-hero: linear-gradient(160deg, #f8fafc 0%, #f0fdfa 30%, #ecfeff 60%, #f8fafc 100%);
            --gradient-card: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
            --gradient-accent: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);
            --gradient-text: linear-gradient(135deg, #0f172a 0%, #334155 100%);

            --tag-bg: #f0fdfa;
            --tag-text: #0f766e;
            --tag-border: rgba(13, 148, 136, 0.2);

            --card-shadow: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
            --card-shadow-hover: 0 10px 40px rgba(0,0,0,0.08), 0 2px 8px rgba(0,0,0,0.04);
            --card-shadow-accent: 0 8px 32px rgba(13,148,136,0.08), 0 2px 8px rgba(0,0,0,0.04);

            --nav-bg: rgba(255,255,255,0.85);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-deep);
            color: var(--text-primary);
            line-height: 1.75;
            transition: background 0.5s ease, color 0.5s ease;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .grid-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 0;
            pointer-events: none;
            opacity: 0.03;
            background-image:
                linear-gradient(rgba(94,234,219,0.5) 1px, transparent 1px),
                linear-gradient(90deg, rgba(94,234,219,0.5) 1px, transparent 1px);
            background-size: 60px 60px;
            background-position: center center;
        }

        .dna-decoration {
            position: fixed;
            top: -120px;
            right: -180px;
            width: 500px;
            height: 500px;
            z-index: 0;
            pointer-events: none;
            opacity: 0.04;
            border-radius: 50%;
            border: 2px solid var(--accent-bright);
            animation: rotate-slow 60s linear infinite;
        }
        .dna-decoration::before {
            content: '';
            position: absolute;
            inset: 40px;
            border-radius: 50%;
            border: 1.5px solid var(--accent);
            animation: rotate-slow 40s linear infinite reverse;
        }
        .dna-decoration::after {
            content: '';
            position: absolute;
            inset: 90px;
            border-radius: 50%;
            border: 1px solid var(--accent-deep);
            animation: rotate-slow 30s linear infinite;
        }
        @keyframes rotate-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .dna-decoration-2 {
            position: fixed;
            bottom: -100px;
            left: -150px;
            width: 400px;
            height: 400px;
            z-index: 0;
            pointer-events: none;
            opacity: 0.03;
            border-radius: 50%;
            border: 2px solid var(--accent);
            animation: rotate-slow 50s linear infinite reverse;
        }
        .dna-decoration-2::before {
            content: '';
            position: absolute;
            inset: 30px;
            border-radius: 50%;
            border: 1.5px solid var(--accent-bright);
            animation: rotate-slow 35s linear infinite;
        }

        .main-container {
            position: relative;
            z-index: 1;
            max-width: 900px;
            margin: 0 auto;
            padding: 0 32px;
        }

        .nav-wrapper {
            position: sticky;
            top: 0;
            z-index: 100;
            background: var(--nav-bg);
            backdrop-filter: var(--nav-blur);
            -webkit-backdrop-filter: var(--nav-blur);
            border-bottom: 1px solid var(--border);
            transition: all 0.4s ease;
        }
        .nav-inner {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 68px;
        }
        .nav-logo {
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.01em;
            color: var(--text-primary);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .nav-logo-icon {
            width: 34px;
            height: 34px;
            border-radius: var(--radius-xs);
            background: var(--gradient-accent);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            font-weight: 800;
            color: #0b1121;
            letter-spacing: 0;
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .nav-links-desktop {
            display: flex;
            gap: 28px;
            list-style: none;
            align-items: center;
        }
        .nav-links-desktop a {
            text-decoration: none;
            color: var(--text-secondary);
            font-size: 0.88rem;
            font-weight: 500;
            transition: color 0.2s;
            position: relative;
            letter-spacing: 0.01em;
        }
        .nav-links-desktop a::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 2px;
            background: var(--accent-bright);
            transition: width 0.3s ease;
            border-radius: 2px;
        }
        .nav-links-desktop a:hover { color: var(--text-primary); }
        .nav-links-desktop a:hover::after { width: 70%; }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .theme-toggle {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: 50%;
            width: 38px;
            height: 38px;
            cursor: pointer;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all var(--transition);
            color: var(--text-secondary);
        }
        .theme-toggle:hover {
            border-color: var(--accent);
            color: var(--accent-bright);
            box-shadow: 0 0 20px var(--accent-glow);
        }

        .hamburger {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            flex-direction: column;
            gap: 5px;
            padding: 8px;
            z-index: 101;
        }
        .hamburger span {
            display: block;
            width: 22px;
            height: 2px;
            background: var(--text-primary);
            transition: all 0.3s;
            border-radius: 2px;
        }
        .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px,5px); }
        .hamburger.active span:nth-child(2) { opacity: 0; }
        .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5px); }

        .mobile-menu {
            display: none;
            position: fixed;
            top: 68px; left: 0;
            width: 100%;
            background: var(--nav-bg);
            backdrop-filter: var(--nav-blur);
            border-bottom: 1px solid var(--border);
            padding: 28px 32px;
            flex-direction: column;
            gap: 18px;
            z-index: 99;
            transform: translateY(-120%);
            transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .mobile-menu.active { transform: translateY(0); }
        .mobile-menu a {
            text-decoration: none;
            color: var(--text-primary);
            font-size: 1.05rem;
            font-weight: 500;
            padding: 6px 0;
        }

        .hero {
            padding: 100px 0 70px;
            position: relative;
        }
        .hero-accent-line {
            width: 50px;
            height: 3px;
            background: var(--gradient-accent);
            border-radius: 3px;
            margin-bottom: 28px;
        }
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--bg-surface);
            color: var(--accent-bright);
            font-size: 0.78rem;
            font-weight: 600;
            padding: 7px 18px;
            border-radius: 24px;
            margin-bottom: 28px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            border: 1px solid var(--border-accent);
        }
        .hero-badge-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--accent-bright);
            box-shadow: 0 0 10px var(--accent-glow);
            animation: pulse-dot 2s ease-in-out infinite;
        }
        @keyframes pulse-dot {
            0%,100% { box-shadow: 0 0 8px var(--accent-glow); }
            50% { box-shadow: 0 0 22px var(--accent-glow-strong); }
        }
        .hero h1 {
            font-family: 'Inter', sans-serif;
            font-size: clamp(2.6rem, 5.5vw, 4rem);
            font-weight: 800;
            letter-spacing: -0.05em;
            line-height: 1.08;
            margin-bottom: 12px;
            background: var(--gradient-text);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero .subtitle {
            font-size: 1.05rem;
            color: var(--text-muted);
            margin-bottom: 8px;
            font-weight: 400;
            letter-spacing: 0.02em;
        }
        .hero .tagline {
            font-size: 1.25rem;
            color: var(--text-secondary);
            max-width: 620px;
            border-left: 3px solid var(--accent);
            padding-left: 22px;
            margin-top: 32px;
            font-weight: 400;
            line-height: 1.65;
        }
        .typed-wrapper {
            display: inline;
            color: var(--accent-bright);
            font-weight: 600;
            background: linear-gradient(135deg, var(--accent-bright), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .section {
            padding: 70px 0;
        }
        .section-label {
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--accent-bright);
            margin-bottom: 8px;
            font-weight: 500;
        }
        .section-title {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            margin-bottom: 28px;
            line-height: 1.2;
            color: var(--text-primary);
        }
        .section p {
            color: var(--text-secondary);
            margin-bottom: 18px;
            font-size: 1.02rem;
            line-height: 1.8;
        }
        .section p strong {
            color: var(--text-primary);
            font-weight: 600;
        }
        .highlight {
            color: var(--accent-bright);
            font-weight: 500;
        }

        .divider {
            border: none;
            height: 1px;
            background: var(--border);
            margin: 12px 0;
            position: relative;
        }
        .divider::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 80px;
            height: 1px;
            background: var(--gradient-accent);
        }

        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-top: 28px;
        }
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 30px 28px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            box-shadow: var(--card-shadow);
        }
        .card::after {
            content: '';
            position: absolute;
            inset: -1px;
            border-radius: var(--radius);
            padding: 1px;
            background: var(--gradient-accent);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s;
        }
        .card:hover {
            transform: translateY(-6px);
            box-shadow: var(--card-shadow-accent);
            border-color: var(--border-accent);
        }
        .card:hover::after { opacity: 0.5; }
        .card-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-surface);
            border-radius: var(--radius-sm);
            font-size: 1.5rem;
            margin-bottom: 18px;
            border: 1px solid var(--border);
        }
        .card h3 {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 10px;
            letter-spacing: -0.01em;
            color: var(--text-primary);
        }
        .card p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 0;
            line-height: 1.65;
        }
        .card-tags {
            margin-top: 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .tag {
            display: inline-block;
            background: var(--tag-bg);
            color: var(--tag-text);
            font-size: 0.72rem;
            padding: 5px 14px;
            border-radius: 20px;
            font-weight: 500;
            letter-spacing: 0.03em;
            border: 1px solid var(--tag-border);
        }

        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 14px;
            margin-top: 20px;
        }
        .service-item {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 22px;
            transition: all var(--transition);
            box-shadow: var(--card-shadow);
        }
        .service-item:hover {
            border-color: var(--border-accent);
            box-shadow: var(--card-shadow-accent);
            transform: translateY(-3px);
        }
        .service-item .service-icon {
            font-size: 1.3rem;
            margin-bottom: 10px;
            display: block;
        }
        .service-item strong {
            display: block;
            font-size: 0.92rem;
            margin-bottom: 4px;
            font-weight: 600;
            color: var(--text-primary);
        }
        .service-item span {
            color: var(--text-muted);
            font-size: 0.83rem;
            line-height: 1.5;
        }

        .glass-card {
            background: var(--bg-glass);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 28px;
            box-shadow: var(--card-shadow);
            transition: all var(--transition);
            margin-top: 24px;
        }
        .glass-card h3 {
            font-weight: 600;
            margin-bottom: 8px;
            color: var(--text-primary);
        }
        .glass-card p {
            color: var(--text-secondary);
            font-size: 0.93rem;
        }
        .glass-card .warning-note {
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 10px;
            font-style: italic;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 14px;
            margin-top: 24px;
        }
        .contact-item {
            display: flex;
            align-items: center;
            gap: 14px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            padding: 18px 20px;
            text-decoration: none;
            color: var(--text-primary);
            transition: all var(--transition);
            box-shadow: var(--card-shadow);
        }
        .contact-item:hover {
            border-color: var(--accent);
            box-shadow: var(--card-shadow-accent);
            transform: translateY(-2px);
        }
        .contact-item .contact-icon {
            font-size: 1.4rem;
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-surface);
            border-radius: var(--radius-xs);
            flex-shrink: 0;
            border: 1px solid var(--border);
        }
        .contact-item .contact-info {
            font-size: 0.88rem;
            font-weight: 500;
        }
        .contact-item .contact-info small {
            display: block;
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: 400;
            margin-top: 2px;
        }
        .contact-item-disabled {
            cursor: default;
            opacity: 0.7;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--gradient-accent);
            color: #0b1121;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 12px 24px;
            border-radius: 28px;
            text-decoration: none;
            transition: all var(--transition);
            box-shadow: 0 4px 20px var(--accent-glow);
            letter-spacing: 0.02em;
            margin-top: 12px;
        }
        .cta-button:hover {
            box-shadow: 0 6px 28px var(--accent-glow-strong);
            transform: translateY(-2px);
        }

        .footer {
            text-align: center;
            padding: 36px 0;
            color: var(--text-muted);
            font-size: 0.83rem;
            border-top: 1px solid var(--border);
            margin-top: 50px;
        }
        .footer-inner {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }
        .footer-built {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
        }
        .footer-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent-bright);
            animation: pulse-dot 2s ease-in-out infinite;
        }

        .reveal {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        #loader {
            position: fixed;
            inset: 0;
            background: var(--bg-deep);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 20px;
            transition: opacity 0.6s ease, visibility 0.6s ease;
        }
        #loader.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        .loader-icon {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-xs);
            background: var(--gradient-accent);
            animation: loader-pulse 1.2s ease-in-out infinite;
        }
        @keyframes loader-pulse {
            0%,100% { transform: scale(1); box-shadow: 0 0 20px var(--accent-glow); }
            50% { transform: scale(1.15); box-shadow: 0 0 40px var(--accent-glow-strong); }
        }
        .loader-text {
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
        }

        @media (max-width: 768px) {
            .nav-links-desktop { display: none; }
            .hamburger { display: flex; }
            .mobile-menu { display: flex; }
            .hero { padding: 60px 0 44px; }
            .section { padding: 48px 0; }
            .section-title { font-size: 1.55rem; }
            .card-grid { grid-template-columns: 1fr; }
            .service-grid { grid-template-columns: 1fr; }
            .contact-grid { grid-template-columns: 1fr; }
            .footer-inner { flex-direction: column; text-align: center; }
            .dna-decoration, .dna-decoration-2 { opacity: 0.02; }
        }
        @media (max-width: 480px) {
            .main-container { padding: 0 18px; }
            .nav-inner { padding: 0 18px; }
            .hero h1 { font-size: 2rem; }
            .hero .tagline { font-size: 1.05rem; padding-left: 16px; }
            .section-title { font-size: 1.35rem; }
        }
    </style>
</head>
<body>

